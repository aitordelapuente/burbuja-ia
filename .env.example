# ---------- Aplicación (Vercel) ----------
# Obligatoria: cabecera para SEC EDGAR (pon un correo de contacto real).
SEC_USER_AGENT="PanelPinchazoIA admin@example.com"
# Obligatoria en Vercel: protege /api/cron/refresh (Vercel Cron la envía como Bearer). Genera uno aleatorio: openssl rand -hex 32
CRON_SECRET=
# Obligatoria: protege /api/health?detalle=1 (lo usa el job de monitorización).
HEALTH_TOKEN=
# Opcional: índice oficial de Silicon Data por API (de pago). Sin clave se usa data/manual/gpu_alquiler.csv.
SILICONDATA_API_KEY=
# Opcional: API oficial de FRED en lugar del CSV público.
FRED_API_KEY=
# Opcional: URL pública (enlaces absolutos y monitorización).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: User-Agent para Yahoo, Polymarket, RunPod, Vast, Azure y AWS.
HTTP_USER_AGENT="Mozilla/5.0 (PanelPinchazoIA)"
# 1 = usar los fixtures de tests/fixtures (CI y tests). Déjalo vacío en producción.
MOCK_DATA=

# ---------- GitHub Actions (secretos y variables del repositorio) ----------
# RESEARCH_API_KEY        (secreto)  clave de la IA del investigador J2 (compatible con la API de OpenAI). Alias: PERPLEXITY_API_KEY
# RESEARCH_API_URL        (variable) por defecto https://api.perplexity.ai/chat/completions
# RESEARCH_MODEL          (variable) por defecto sonar-pro
# RESEARCH_MAX_USD_DIA    (variable) por defecto 1.00
# SEC_USER_AGENT          (variable) el mismo que en la app
# SITE_URL                (variable) URL de producción para el monitor J3
# HEALTH_TOKEN            (secreto)  el mismo que en la app
# ALERT_WEBHOOK_URL       (secreto, opcional) webhook de Slack/Teams/Discord
# RESEND_API_KEY, ALERT_EMAIL_TO, ALERT_EMAIL_FROM (opcionales) alertas por correo
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID (opcionales) solo si no usas la integración Git de Vercel
